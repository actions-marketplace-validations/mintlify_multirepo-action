{
  "name": "mintlify-multirepo-action",
  "version": "1.0.0",
  "private": true,
  "description": "Combine Mintlify docs from many repositories into one docs repository",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "type": "tsc --noEmit",
